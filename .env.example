# =============================================================================
# AI Door Web MVP - environment example
# -----------------------------------------------------------------------------
# `.env.local` 로 복사해서 채우세요. `.env.local` 은 절대 커밋하지 않습니다.
#
# 이 파일의 모든 값은 서버 전용입니다. NEXT_PUBLIC_ 접두사가 붙은 키가
# 하나도 없으므로 브라우저 번들에 포함될 수 없습니다.
#
# 실제 API 키를 이 파일(.env.example)에 적지 마세요. 변수 이름만 남깁니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 분석 제공자
# -----------------------------------------------------------------------------
# openai  : OpenAI Responses API (온라인 기본 모드)
# ollama  : 로컬 Qwen3-VL (오프라인)
# fixture : 네트워크 없이 사전 검증된 합성문서 결과 (안전 시연 모드)
#
# 키가 없거나 제공자를 쓸 수 없으면 서버가 fixture 로 전환하고,
# 화면에 "데모 모드로 전환됨" 배지와 이유를 표시합니다. 숨기지 않습니다.
AI_PROVIDER=fixture

# 브라우저가 제공자를 지정할 수 있게 허용할지.
# 발표장에서는 편리하고 운영에서는 위험하므로 스위치로 둡니다.
ALLOW_CLIENT_PROVIDER_OVERRIDE=true

# -----------------------------------------------------------------------------
# 2. OpenAI (온라인 기본 모드)
# -----------------------------------------------------------------------------
# 키 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenAI 호환 게이트웨이를 쓰려면 이 주소만 바꾸면 됩니다.
OPENAI_BASE_URL=https://api.openai.com/v1
# 모델 ID 는 여기에만 존재합니다. 코드에 하드코딩하지 않습니다.
OPENAI_MODEL=gpt-5.6-luna
# 1차 결과가 검증에 실패했을 때 딱 한 번만 사용하는 재분석 모델입니다.
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=3000

# -----------------------------------------------------------------------------
# 3. Ollama (로컬 모드)
# -----------------------------------------------------------------------------
# 설치: https://ollama.com  →  ollama pull qwen3-vl:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# RTX 5060 Laptop 8GB VRAM 기준 기본값. 라이브 시연에 권장합니다.
OLLAMA_MODEL=qwen3-vl:4b
# 선택적 고품질 모드. 기본값으로 쓰지 마세요.  ollama pull qwen3-vl:8b
OLLAMA_QUALITY_MODEL=qwen3-vl:8b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# 4. 업로드 제한
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=6000000
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp
# 브라우저에서 긴 변 기준으로 축소하는 크기. EXIF 는 이때 함께 제거됩니다.
MAX_IMAGE_EDGE_PX=1600

# -----------------------------------------------------------------------------
# 5. 스키마 검증 재시도
# -----------------------------------------------------------------------------
# JSON 검증 실패 시 재시도 횟수. 1 이면 한 번만 더 시도하고,
# 그래도 실패하면 사용자에게 Fixture 전환을 물어봅니다.
MAX_SCHEMA_RETRIES=1

# -----------------------------------------------------------------------------
# 6. 실험 이벤트 로그
# -----------------------------------------------------------------------------
# 비식별 이벤트만 기록합니다. 문서 본문, 이미지, 개인정보는
# 저장 전에 스키마에서 거부됩니다.
EXPERIMENT_LOG_ENABLED=true
# 프로젝트 루트 기준 상대경로. 이 디렉터리는 gitignore 됩니다.
EXPERIMENT_LOG_DIR=.data
